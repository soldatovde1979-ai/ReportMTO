|    втЗН.т1кГруппаТехники,
|    втЗН.т1кГаражныйНомер,
|    втЗН.ДлительностьЧасы,
|    втЗН.т1кГодВыпуска,
|    втЗН.т1кСектор,
|    втЗН.ОбъектОФ,
|    втЗН.СтоимостьМатериалов,
|    втЗН.ЧасыТрудозатрат,
|    втЗН.ЗНЗакрыт,
|    втЗН.Спидометр,
|    втЗН.СчетчикМЧ,
|    ВЫБОР
|        КОГДА втЗН.Сотрудник.Подразделение В (&ДГМ)
|            ТОГДА ""ДГМ""
|        КОГДА втЗН.Сотрудник.Подразделение В (&ДЭНТ)
|            ТОГДА ""ДЭНТ""
|        КОГДА втЗН.Сотрудник.Подразделение ЕСТЬ NULL
|            ТОГДА """"
|        ИНАЧЕ ""?""
|    КОНЕЦ
|
|УПОРЯДОЧИТЬ ПО
|    ДатаСтатуса";

лЗапрос.УстановитьПараметр("Дата1", Дата1);
лЗапрос.УстановитьПараметр("Дата2", Дата2);
лЗапрос.УстановитьПараметр("ДатаСтатусаПустая", Дата(1, 1, 1, 0, 0, 0));

Вид = Новый Массив;
Вид.Добавить(Перечисления.уатВидыМоделейТС.Автотранспорт);
лЗапрос.УстановитьПараметр("Вид", Вид);

лЗапрос.УстановитьПараметр("СтатусГотовКПриемке", Справочники.eamСтатусыОбъектов.НайтиПоНаименованию("Готов к приемке"));
лЗапрос.УстановитьПараметр("СтатусГотовКВыдаче", Справочники.eamСтатусыОбъектов.НайтиПоНаименованию("Готов к выбытию"));
лЗапрос.УстановитьПараметр("СтатусЗакрыт", Справочники.eamСтатусыОбъектов.НайтиПоКоду( "000000026"));

ДЭНТ = Новый Массив;
ДЭНТ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Дирекция эксплуатации наземной техники"));
ДЭНТ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Служба водителей спец. и доставки СНО"));
ДЭНТ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Служба технического планирования"));
ДЭНТ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Служба проверки и выпуска техники"));
ДЭНТ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Отдел договорной работы"));
ДЭНТ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Служба доставки пассажиров (ДЭНТ)"));
лЗапрос.УстановитьПараметр("ДЭНТ", ДЭНТ);

ДГМ = Новый Массив;
ДГМ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Служба ремонта техники и средств наземного обслуживания"));
ДГМ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Дирекция главного механика"));
ДГМ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Служба контроля технического обслуживания и ремонта спецтехники и СНО"));
ДГМ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Отдел заправки средств перронной механизации"));
ДГМ.Добавить(Справочники.СтруктураПредприятия.НайтиПоНаименованию("Отдел договорной работы"));
лЗапрос.УстановитьПараметр("ДГМ", ДГМ);

Результат = лЗапрос.Выполнить();
Если Результат.Пустой() Тогда Возврат Неопределено; КонецЕсли;

Поток = Новый ПотокВПамяти();
ЗаписьJSON = Новый ЗаписьJSON;
ЗаписьJSON.ОткрытьПоток(Поток, , , Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ", Истина));
ЗаписьJSON.ЗаписатьНачалоМассива();

КоличествоЗаписей = 0;
лВыборка = Результат.Выбрать();

Пока лВыборка.Следующий() Цикл
    КоличествоЗаписей = КоличествоЗаписей + 1;
    ЗаписьJSON.ЗаписатьНачалоОбъекта();

    ЗаписьJSON.ЗаписатьИмяСвойства("number"); ЗаписьJSON.ЗаписатьЗначение(СокрЛП(лВыборка.Номер));
    ЗаписьJSON.ЗаписатьИмяСвойства("date"); ЗаписьJSON.ЗаписатьЗначение(Формат(лВыборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
    ЗаписьJSON.ЗаписатьИмяСвойства("ready_for"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.ГотовК));
    ЗаписьJSON.ЗаписатьИмяСвойства("direction"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.Дирекция));
    ЗаписьJSON.ЗаписатьИмяСвойства("status_date"); ЗаписьJSON.ЗаписатьЗначение(Формат(лВыборка.ДатаСтатуса, "ДФ=yyyy-MM-ddTHH:mm:ss"));
    ЗаписьJSON.ЗаписатьИмяСвойства("employee"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.Сотрудник));
    ЗаписьJSON.ЗаписатьИмяСвойства("arm"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.АРМ));
    ЗаписьJSON.ЗаписатьИмяСвойства("post"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.ПостРемзоны));
    ЗаписьJSON.ЗаписатьИмяСвойства("day_status"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.ДЕНЬ_Статус);
    ЗаписьJSON.ЗаписатьИмяСвойства("month_status"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.МЕСЯЦ_Статус);
    ЗаписьJSON.ЗаписатьИмяСвойства("year_status"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.ГОД_Статус);
    ЗаписьJSON.ЗаписатьИмяСвойства("week_status"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.НЕДЕЛЯ_Статус);
    ЗаписьJSON.ЗаписатьИмяСвойства("zn_type"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.СсылкаТипЗаказНаряда));
    ЗаписьJSON.ЗаписатьИмяСвойства("emp_dep"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.СотрудникПодр));
    ЗаписьJSON.ЗаписатьИмяСвойства("model_type"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.СсылкаОбъектОФт1кТСиОборудованиеуатМодельВидМоделиТС));
    ЗаписьJSON.ЗаписатьИмяСвойства("in_bounds"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.ВГраницеОтбора);
    ЗаписьJSON.ЗаписатьИмяСвойства("defekt_type"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.ДокументОснованиешхКлассификаторДефекта));
    ЗаписьJSON.ЗаписатьИмяСвойства("defect_desc"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.ДокументОснованиет1кОписание));

    // Новые поля
    ЗаписьJSON.ЗаписатьИмяСвойства("owner_dep"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.Подразделение));
    ЗаписьJSON.ЗаписатьИмяСвойства("TekStatusPoDoc"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.СтатусДок));
    ЗаписьJSON.ЗаписатьИмяСвойства("vehicle_group"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.т1кГруппаТехники));
    ЗаписьJSON.ЗаписатьИмяСвойства("vehicle_number"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.т1кГаражныйНомер));
    ЗаписьJSON.ЗаписатьИмяСвойства("hourdlit"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.ДлительностьЧасы);
    ЗаписьJSON.ЗаписатьИмяСвойства("MadeYear"); ЗаписьJSON.ЗаписатьЗначение(Формат(лВыборка.т1кГодВыпуска, "ДФ=yyyy-MM-ddTHH:mm:ss"));
    ЗаписьJSON.ЗаписатьИмяСвойства("Sektor"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.т1кСектор));
    ЗаписьJSON.ЗаписатьИмяСвойства("cost_parts"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.СтоимостьМатериалов);
    ЗаписьJSON.ЗаписатьИмяСвойства("cost_Trudozatrat"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.ЧасыТрудозатрат);
    ЗаписьJSON.ЗаписатьИмяСвойства("ts"); ЗаписьJSON.ЗаписатьЗначение(Строка(лВыборка.ОбъектОФ));

    Если ЗначениеЗаполнено(лВыборка.ЗНЗакрыт) Тогда
        ЗаписьJSON.ЗаписатьИмяСвойства("zn_closed"); ЗаписьJSON.ЗаписатьЗначение(Формат(лВыборка.ЗНЗакрыт, "ДФ=yyyy-MM-ddTHH:mm:ss"));
    Иначе
        ЗаписьJSON.ЗаписатьИмяСвойства("zn_closed"); ЗаписьJSON.ЗаписатьЗначение(Неопределено); // Запишет null в JSON, если пусто
    КонецЕсли;

    ЗаписьJSON.ЗаписатьИмяСвойства("odometer"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.Спидометр);
    ЗаписьJSON.ЗаписатьИмяСвойства("engine_hours"); ЗаписьJSON.ЗаписатьЗначение(лВыборка.СчетчикМЧ);

    ЗаписьJSON.ЗаписатьКонецОбъекта();
КонецЦикла;

ЗаписьJSON.ЗаписатьКонецМассива();
ЗаписьJSON.Закрыть();

Возврат Новый Структура("Данные, Количество", Поток.ЗакрытьИПолучитьДвоичныеДанные(), КоличествоЗаписей);

КонецФункции
# v2.1 от 14.09.2026 — приведено к стандарту folders v2.1, раздел 2.

# Данные и результаты: вне git, только каркасы .gitkeep.
data/*
result/*
!data/.gitkeep
!result/.gitkeep

# Рабочая книга и рантайм-лог в корне — вне git.
# Книги из build/ передаются в git (политика проекта), этот игнор их не касается.
/ReportMTO.xlsm
/ReportMTO_log.txt
~$*

# Бэкапы — вне git, сами файлы не удалять.
*.bak
*.bak_*
bak/

# Временная диагностика в tools/ — вне git.
tools/*_tmp*
tools/*.log
tools/log_*.txt

# Лог книги в build/ — вне git (лог живёт рядом с книгой в корне).
build/*.log
build/ReportMTO_log.txt

# Прежние правила
/node_modules
logs
/xvba_excel_backup
.gitignore
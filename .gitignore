# .gitignore
# Версия 2.2 от 08.09.2026 — добавлен ReportMTO_log.txt (runtime-лог книги, вне git).
# Версия 2.1 от 08.09.2026 — добавлена папка bak/ (бэкапы книг ReportMTO, правило проекта).
# Версия 2.0 от 08.09.2026 — стандартизация структуры (стандарт folders v2.1):
#   добавлено правило *.bak_* (локальные бэкапы вида *.bak_<штамп> вне git, сами файлы не удаляются);
#   папка Data/ переименована в data/ (правила ниже уже строчными).

# Служебные файлы блокировки Excel
~$*.xlsm
~$*.xlsx

# Резервные копии книг и локальные бэкапы
*.bak
*.bak_*
bak/
ReportMTO — копия.xlsm

# Локальная книга в корне проекта — собирается скриптом и хранится вне git
/ReportMTO.xlsm

# Runtime-лог книги (VBA, DEBUG 0/1/2) — дописывается при каждом запуске, вне git
/ReportMTO_log.txt

# Локальный бэкап репозитория (вложенный git-репозиторий)
repo_github_current/

# Папка result: в git только каркас (.gitkeep), файлы результатов не передаются
result/*
!result/.gitkeep

# Кэш Python
__pycache__/
*.pyc

# Реорганизация v2 (05.09.2026): данные и служебное - вне git
# (build\ передаётся в git-обмен целиком, включая собранные книги)
data/*
!data/.gitkeep
.claude/
_to_delete/

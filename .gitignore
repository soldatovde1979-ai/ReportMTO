# .gitignore
# Версия 2.5 от 15.09.2026 — gitignore для ZIP-дампа 68787400, ReportMTO.log,
# archive/ReportMTO._xlsm.

# Служебные файлы блокировки Excel
~$*

# Резервные копии книг и локальные бэкапы
*.bak
*.bak_*
bak/
ReportMTO — копия.xlsm

# Локальная книга в корне проекта — собирается скриптом и хранится вне git
/ReportMTO.xlsm

# Старая копия книги в корне (не собирается скриптом, в git не нужна)
/ReportMTO._xlsm

# Временная копия книги в archive (появляется при сохранении из COM)
/archive/ReportMTO._xlsm

# Случайный ZIP-дамп в корне (временный, ~52 МБ)
/68787400

# Runtime-лог книги (VBA, DEBUG 0/1/2) — дописывается при каждом запуске, вне git
/ReportMTO_log.txt
/ReportMTO.log

# Локальный бэкап репозитория (вложенный git-репозиторий)
repo_github_current/

# Ключи внешних провайдеров ИИ — в git не попадают ни при каких условиях
*.key

# Данные и результаты: вне git, только каркасы .gitkeep.
data/*
result/*
!data/.gitkeep
!result/.gitkeep

# Кэш Python
__pycache__/
*.pyc

# Служебные папки
.claude/
_to_delete/

# Скриншоты и файлы, отданные в чат — не содержимое проекта
Claude outputs/

# Рабочие копии модулей в ANSI-1251 для импорта в VBE: производные от src/vba
tools/_import_ansi/

# Временная диагностика в tools/ — вне git.
tools/*_tmp*
tools/*.log
tools/log_*.txt

# Лог книги в build/ — вне git (лог живёт рядом с книгой в корне).
build/*.log
build/ReportMTO_log.txt

# Прежние правила
/node_modules
logs
/xvba_excel_backup
